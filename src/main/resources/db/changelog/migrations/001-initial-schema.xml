<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-schema" author="digi-cart" runAlways="true">
        <validCheckSum>ANY</validCheckSum>
        <sql>CREATE SCHEMA IF NOT EXISTS audit_log_svc</sql>
    </changeSet>

    <changeSet id="002-create-audit-log" author="digi-cart">
        <createTable tableName="audit_log" schemaName="audit_log_svc">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="VARCHAR(50)" defaultValue="info">
                <constraints nullable="false"/>
            </column>
            <column name="method" type="VARCHAR(20)"/>
            <column name="path" type="VARCHAR(1024)"/>
            <column name="user_id" type="VARCHAR(255)"/>
            <column name="user_role" type="VARCHAR(255)"/>
            <column name="store_id" type="VARCHAR(255)"/>
            <column name="status_code" type="INTEGER"/>
            <column name="duration" type="INTEGER"/>
            <column name="message" type="TEXT"/>
            <column name="meta" type="JSONB"/>
            <column name="ip_address" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="audit_log" schemaName="audit_log_svc" indexName="idx_audit_log_store_id">
            <column name="store_id"/>
        </createIndex>
        <createIndex tableName="audit_log" schemaName="audit_log_svc" indexName="idx_audit_log_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="audit_log" schemaName="audit_log_svc" indexName="idx_audit_log_service">
            <column name="service"/>
        </createIndex>
        <createIndex tableName="audit_log" schemaName="audit_log_svc" indexName="idx_audit_log_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-audit-settings" author="digi-cart">
        <createTable tableName="audit_settings" schemaName="audit_log_svc">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="retention_days" type="INTEGER" defaultValueNumeric="30">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
